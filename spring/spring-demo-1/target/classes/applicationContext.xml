<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
	<bean id="a1" class="com.empower.demo.beans.Author">
		<property name="id" value="121" />
		<property name="firstName" value="Shiv" />
		<property name="lastName" value="Khera" />		
	</bean>
	
	<bean id="b1" class="com.empower.demo.beans.Book" scope="prototype">
		<property name="isbn" value="201"></property>
		<property name="title" value="You can win" />
		<property name="author" ref="a1" />
		<property name="price" value="105.5" />
	</bean>
</beans>